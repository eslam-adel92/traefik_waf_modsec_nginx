# Copy to .env and adjust. `docker compose` reads .env automatically.

# ---- Routing --------------------------------------------------------------
# Only used by the optional demo backend (`docker compose --profile demo up`).
# Real applications set their own Host() rule in their own compose file.
APP_DOMAIN=whoami.localhost

# Certificate resolver for routers. LEAVE EMPTY for local/dev domains.
#   ""           -> no ACME; Traefik serves its own self-signed cert
#   "letsencrypt" -> request a real certificate (public domain + port 80 reachable)
# Let's Encrypt refuses names without a valid public TLD (.localhost, .test,
# .internal), and Traefik retries noisily against your ACME rate limit if you
# point a resolver at one. That is the error the old empty `certresolver=`
# labels were working around - this variable is the supported way to do it.
CERT_RESOLVER=

# ---- WAF ------------------------------------------------------------------
# CRS blocking paranoia, 1-4.
#   1 = CRS default, very few false positives
#   2 = recommended here: catches noticeably more with manageable tuning
#   3 = aggressive; rejects newlines in input (rule 920272), unusual charsets,
#       etc. Only run PL3 if you will actually tune the false positives - a
#       PL3 setup that gets switched off protects less than a PL2 one left on.
PARANOIA=2

# Anomaly score needed to block. Lower = stricter. ANOMALY_OUTBOUND is inert
# in this architecture (the real response never reaches ModSecurity).
ANOMALY_INBOUND=10
ANOMALY_OUTBOUND=5

# On | DetectionOnly | Off. Use DetectionOnly to tune without blocking.
MODSEC_RULE_ENGINE=On

# Host-specific WAF tuning. custom-rules.conf is a shared template and must
# not name real hosts; anything that does belongs in your own file here.
#   cp modsec/site-rules.conf.example modsec/site-rules.conf
#   SITE_RULES_FILE=./modsec/site-rules.conf
# Leave unset to use the committed example (comments only, no rules).
#SITE_RULES_FILE=./modsec/site-rules.conf

# Methods CRS rule 911100 permits. Anything else gets a 403 that browsers
# report as a CORS error. Space-separated. Drop what your app never uses.
ALLOWED_METHODS=GET HEAD POST PUT PATCH DELETE OPTIONS

# ---- Body size / timeouts -------------------------------------------------
# The Traefik plugin buffers each request body IN MEMORY before forwarding it
# to the WAF. Worst-case memory is roughly:
#     WAF_MAX_BODY_SIZE x INFLIGHT_LIMIT x (concurrent client IPs)
# Keep the default low and use the `waf-uploads` chain on the few routes that
# genuinely need large bodies.
WAF_MAX_BODY_SIZE=20971520        # 20 MB - default for the `waf` chain
WAF_TIMEOUT_MILLIS=60000          # must exceed time to push that body to WAF

# Used only by the `waf-uploads` chain. Paired with UPLOAD_INFLIGHT_LIMIT
# below, worst case here is 300MB x 4 = ~1.2GB per client IP - size the host
# accordingly, or lower one of the two.
WAF_UPLOAD_MAX_BODY_SIZE=314572800  # 300 MB
WAF_UPLOAD_TIMEOUT_MILLIS=600000

# ---- Compression ----------------------------------------------------------
# Only affects backends that do not compress themselves: Traefik skips any
# response that already carries Content-Encoding, so enabling gzip at the
# application (e.g. GF_SERVER_ENABLE_GZIP for Grafana) wins and is not
# double-compressed. Encodings offered: gzip, br, zstd.
#
# Trade-off worth knowing: compressing a response that mixes a secret (CSRF
# token, session id) with reflected attacker-controlled input is the BREACH
# side-channel. The attack needs many adaptive requests, which RATE_LIMIT_*
# below makes awkward, and compressing is near-universal practice - but if you
# would rather not take it, drop compress@docker from the chains and enable
# compression at each origin instead.
COMPRESS_MIN_BYTES=1024
# Comma-separated. Server-Sent Events must stay uncompressed - buffering them
# breaks streaming. Traefik never compresses application/grpc.
COMPRESS_EXCLUDED_TYPES=text/event-stream

# ---- Behind a CDN / reverse proxy -----------------------------------------
# Comma-separated ranges of a proxy sitting IN FRONT of this gateway. Used as
# ipStrategy.excludedIPs on ratelimit and inflight, so those limits count the
# real client instead of the proxy - otherwise every visitor arriving through
# one CDN edge shares a single budget and real traffic gets throttled.
#
# Leave EMPTY if nothing fronts this gateway. Empty means plain RemoteAddr.
#
# Two things must be done alongside this, or it makes you less safe, not more:
#   1. Add the SAME ranges to entryPoints.*.forwardedHeaders.trustedIPs in
#      traefik/traefik.yaml. Static config cannot read env vars, so that copy
#      is literal. scripts/update-cf-ips.sh refreshes both.
#   2. Every router MUST overwrite X-Forwarded-Host with its own hostname:
#        traefik.http.middlewares.xfh-<app>.headers.customrequestheaders.X-Forwarded-Host=<host>
#      and put that middleware BEFORE the waf chain. Trusting a proxy means
#      believing the X-Forwarded-Host it relays, and host-scoped WAF rules key
#      on exactly that header. See README "Behind Cloudflare".
#
# Cloudflare's current list: ./scripts/update-cf-ips.sh
TRUSTED_PROXY_IPS=

# Migrating off an existing certbot host? Point this at its /etc/letsencrypt and
# serve those certs from traefik/dynamic, so the cutover needs no ACME at all.
#HOST_CERT_STORE=/etc/letsencrypt

# ---- L7 flood control -----------------------------------------------------
# Requests per IP per period, and the burst allowance above it.
RATE_LIMIT_AVERAGE=100
RATE_LIMIT_BURST=200
RATE_LIMIT_PERIOD=1s

# Concurrent in-flight requests per IP. This is the slowloris bound: a slow
# client can hold connections open, but only this many at once.
INFLIGHT_LIMIT=50
UPLOAD_INFLIGHT_LIMIT=4

# ---- Chain composition ----------------------------------------------------
# Which middlewares make up waf@docker / waf-uploads@docker. Override to drop a
# link you do not want.
#
# DROP cors@docker IF YOUR APPLICATION ALREADY SENDS CORS HEADERS. Traefik's
# cors middleware REPLACES them, and the replacement is almost always narrower:
# an app that reflects a specific origin and allows its own custom headers gets
# rewritten to `Access-Control-Allow-Origin: *` plus this file's generic header
# list. Every request carrying an app-specific header (applicationId, platform,
# Idempotency-Key, ...) then fails preflight, and the browser reports it as a
# CORS error with no hint that the gateway caused it.
#
# `*` also cannot be combined with credentials, so an app using cookies or
# `credentials: "include"` breaks the moment this middleware overwrites its
# properly-reflected origin.
#
# Keeping cors@docker is right when the app sends NO CORS headers of its own -
# then Traefik answers preflight before the WAF, so it cannot be 403'd.
# Dropping it is safe as long as OPTIONS is in ALLOWED_METHODS below, which
# lets the preflight reach the app.
#WAF_CHAIN=ratelimit@docker,inflight@docker,compress@docker,modsecurity@docker,securityHeaders@docker
#WAF_UPLOADS_CHAIN=ratelimit@docker,inflight-uploads@docker,compress@docker,modsecurity-large@docker,securityHeaders@docker

# ---- CORS -----------------------------------------------------------------
# Used only when cors@docker is in the chain (see above). Also applied to the
# WAF's 403 responses either way, so a block surfaces as a real 403 in the
# browser instead of a CORS error.
# Use explicit origins in production; "*" cannot be combined with credentials.
CORS_ALLOW_ORIGIN=*
CORS_ALLOW_METHODS=GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With,X-CSRF-TOKEN,X-XSRF-TOKEN
