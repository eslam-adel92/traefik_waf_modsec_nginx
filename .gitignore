# Secrets / local config
.env

# Site-specific WAF rules (real hostnames) - keep out of the public template
modsec/site-rules.conf

# ACME account + certificates
traefik/letsencrypt/*
!traefik/letsencrypt/.gitkeep

# Logs (Traefik and the WAF log to stdout; Docker rotates them)
logs/
*.log

# Editor / OS
.vscode/
.idea/
*.bak
*.tmp
*.swp
*.swo
.DS_Store
